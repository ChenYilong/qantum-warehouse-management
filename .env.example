# Names only. Never commit real values.
# Server-side only. Must never be exposed to the browser (no NEXT_PUBLIC_ prefix).
# The app uses the transaction pooler (port 6543). Migrations use the session pooler (port 5432).
# DB_PASSWORD is set only in Vercel and the operator's shell.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=
DB_SSL_CA=
DB_POOL_MAX=
# memory or postgres. Outside production the default is memory.
# Production must use postgres or leave it unset.
ACTIONS_STORE=
# Non-production only. Ignored when NODE_ENV is production.
# Stub stock for local runs: normal (default), down, empty, or malformed.
STUB_STOCK_MODE=
# Demo identity used until real auth exists (see docs/technical-design.md section 8).
DEMO_USER_ID=demo-leader
# Project maps (AC 74 to 76). The one value here that reaches the browser, by design: a PUBLIC Mapbox token (pk.),
# restricted in Mapbox to the app's URLs. Never a secret token (sk.): the build fails on one. Empty means no maps.
# In CI it comes from the GitHub secret MAPBOX_PUBLIC_TOKEN; locally put it in .env.local.
MAPBOX_PUBLIC_TOKEN=
